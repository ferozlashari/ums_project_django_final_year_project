[Unit]
Description=UMS Celery Beat scheduler
After=network.target postgresql.service
[Service]
User=ums
Group=ums
WorkingDirectory=/srv/ums
# SAME file for every UMS unit: web, worker and beat must share FIELD_ENCRYPTION_KEY.
EnvironmentFile=/etc/ums/ums.env
ExecStart=/srv/ums/venv/bin/celery -A ums_project beat --loglevel=info
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
