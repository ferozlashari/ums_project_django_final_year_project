[Unit]
Description=UMS Built-in scheduler (use INSTEAD of worker+beat, no Redis)
After=network.target postgresql.service
[Service]
User=ums
Group=ums
WorkingDirectory=/srv/ums
# SAME file for every UMS unit: web, worker and beat must share FIELD_ENCRYPTION_KEY.
EnvironmentFile=/etc/ums/ums.env
ExecStart=/srv/ums/venv/bin/python manage.py run_scheduler
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
