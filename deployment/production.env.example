# Production environment template - set these as REAL environment variables
# in your platform's secret manager. Never commit a filled-in copy.
DEBUG=0
DJANGO_SECRET_KEY=            # python -c "import secrets;print(secrets.token_urlsafe(64))"
ALLOWED_HOSTS=ums.example.edu
CSRF_TRUSTED_ORIGINS=https://ums.example.edu

# PostgreSQL (primary database)
DB_ENGINE=postgresql
DATABASE_URL=                  # or POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_HOST / POSTGRES_PORT
DB_SSL_REQUIRE=1               # 0 only for a database inside the same private network

# MUST be identical for the web process, every Celery worker and the scheduler, and must never change
# without the re-encryption procedure in docs/PRODUCTION.md
FIELD_ENCRYPTION_KEY=          # python manage.py generate_encryption_key

# HTTPS behind a reverse proxy (nginx/Caddy/Render/Railway)
SECURE_PROXY_SSL_HEADER=1
SECURE_SSL_REDIRECT=1
SECURE_COOKIES=1
SECURE_HSTS_SECONDS=31536000   # enable only after HTTPS works for the whole domain

# Background jobs (optional but recommended)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SCHEDULER_MODE=celery

# Email (otherwise verification/OTP mail is NOT delivered)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=University Management System <no-reply@ums.example.edu>

# AI assistant: local provider by default; external providers optional
LLM_PROVIDER=local

# Payments (sandbox first; no gateway is considered live until a sandbox test passes)
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENVIRONMENT=sandbox
